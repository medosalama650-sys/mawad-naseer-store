rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "i4tb4fJn8VQ23Fp5VH2wjiNepOz1";
    }

    // المنتجات يقرأها الجميع؛ الكتابة للإدارة فقط.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /priceHistory/{historyId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // العميل يستطيع إرسال طلب جديد فقط؛ لا يستطيع قراءته أو تغييره.
    // الإدارة وحدها ترى الطلبات وتعدّل السعر والحالة.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'buyer','phone','items','notes','status','createdAt'
        ])
        && request.resource.data.buyer is string
        && request.resource.data.buyer.size() > 0
        && request.resource.data.buyer.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && (!('phone2' in request.resource.data) || (request.resource.data.phone2 is string && request.resource.data.phone2.size() <= 40))
        && (
          !('locationLat' in request.resource.data)
          || (request.resource.data.locationLat is number
              && request.resource.data.locationLat >= -90
              && request.resource.data.locationLat <= 90)
        )
        && (
          !('locationLng' in request.resource.data)
          || (request.resource.data.locationLng is number
              && request.resource.data.locationLng >= -180
              && request.resource.data.locationLng <= 180)
        )
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // سجل متابعة محدود: قراءة مستند واحد برقم طلب عشوائي، بلا بيانات شخصية.
    match /tracking/{orderCode} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['status','orderCode','createdAt','updatedAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.orderCode == orderCode
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // يمنع الوصول لأي مجموعة أخرى افتراضيًا.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
